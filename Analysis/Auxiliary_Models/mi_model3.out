INPUT INSTRUCTIONS

  Title: mi_model3

  data:
    file is "S:\Temp\MPlus\Imp_Data_3class\Imp_Data_3class__IMP_LIST.txt";
    type = imputation;

  variable:
    names = par_edu
            big_ope big_con big_ext big_agr big_neu
            int_edi int_ssi int_abi ext_uti ext_lod ext_soi
            aca_abi
            hisei
            str_aca_int nor_aca_int pee_soc_int fac_soc_int
            dro_int dro_out
            bchw1 bchw2 bchw3
            ID_t;

    usevariables = str_aca_int nor_aca_int pee_soc_int fac_soc_int
                   dro_out
                   bchw1 bchw2 bchw3;

    missing = .;
    idvariable = ID_t;

    classes = c (3);
    training = bchw1-bchw3 (bch);
    categorical = dro_out;

  define:
    standardize str_aca_int nor_aca_int pee_soc_int fac_soc_int;

  analysis:
    type = mixture;
    estimator = mlr;
    starts = 0;

  model:
    %overall%
    dro_out on str_aca_int nor_aca_int pee_soc_int fac_soc_int;

    %c#1%
    dro_out on str_aca_int nor_aca_int pee_soc_int fac_soc_int;

    %c#2%
    dro_out on str_aca_int nor_aca_int pee_soc_int fac_soc_int;

    %c#3%
    dro_out on str_aca_int nor_aca_int pee_soc_int fac_soc_int;

  output:
    residual;
    sampstat;
    cinterval;



*** WARNING in VARIABLE command
  Note that only the first 8 characters of variable names are used in the output.
  Shorten variable names to avoid any confusion.
